#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

%:
	dh $@ --buildsystem=cmake

# the CMake configuration goes where find_package() looks for it, and not in
# /usr/cmake, where upstream installs it
override_dh_auto_configure:
	dh_auto_configure -- \
		-DDAQP_CMAKE_INSTALL_DIR=lib/$(DEB_HOST_MULTIARCH)/cmake/daqp
